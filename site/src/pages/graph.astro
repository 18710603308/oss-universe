---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 从项目卡片自动派生图谱节点数据
const projects = await getCollection('projects');

const depthValue = { seed: 20, sprout: 35, tree: 55, peak: 70 };

// 节点：每个项目 + 每个领域（category）
const categories = [...new Set(projects.map((p) => p.data.category))];

// ECharts categories（用于图例与配色）
const chartCategories = categories.map((c) => ({ name: c }));

const nodes = [
  // 领域中心节点
  ...categories.map((c) => ({
    id: `cat:${c}`,
    name: c,
    symbolSize: 60,
    category: c,
    value: '领域',
    itemStyle: { borderColor: '#fff', borderWidth: 2 },
    label: { fontWeight: 'bold' as const, fontSize: 14 },
  })),
  // 项目节点
  ...projects.map((p) => ({
    id: p.id,
    name: p.data.name,
    symbolSize: depthValue[p.data.depth],
    category: p.data.category,
    value: `${p.data.tagline} · ${p.data.born ?? ''} · ${p.data.stars ?? ''}`,
    url: `/projects/${p.id}`,
  })),
];

// 边：项目 → 所属领域
const links = projects.map((p) => ({
  source: p.id,
  target: `cat:${p.data.category}`,
}));

const graphData = { nodes, links, categories: chartCategories };
const graphJson = JSON.stringify(graphData);

// 统计信息
const stats = {
  projectCount: projects.length,
  categoryCount: categories.length,
};
---

<BaseLayout title="生态图谱 · 开源宇宙">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-white">🗺️ 开源生态图谱</h1>
    <p class="mt-2 text-oss-muted">
      共 {stats.projectCount} 个项目、{stats.categoryCount} 个领域的关系网络。节点大小代表学习深度，颜色代表领域。
      拖拽可交互，点击项目节点跳转到卡片详情。
    </p>
  </header>

  <!-- 图例说明 -->
  <div class="mb-4 flex flex-wrap gap-4 text-xs text-oss-muted">
    <span>🔵 节点大小 = 学习深度（越大越深入）</span>
    <span>🎨 颜色 = 所属领域</span>
    <span>🖱️ 可拖拽 / 缩放 / 点击跳转</span>
  </div>

  <div
    id="graph"
    class="w-full rounded-xl border border-oss-border bg-oss-surface"
    style="height: 640px;"
    data-graph={graphJson}
  >
  </div>

  <p class="mt-4 text-center text-sm text-oss-muted">
    图谱数据由项目卡片自动生成 — 每新增一张卡片，图谱自动更新。
  </p>
</BaseLayout>

<script>
  import * as echarts from 'echarts';

  const el = document.getElementById('graph');
  if (el) {
    const data = JSON.parse(el.dataset.graph || '{}');
    const chart = echarts.init(el, 'dark');

    chart.setOption({
      backgroundColor: 'transparent',
      tooltip: {
        formatter: (params: any) => {
          if (params.dataType === 'node') {
            return `<b>${params.data.name}</b><br/>${params.data.value ?? ''}`;
          }
          return '';
        },
      },
      legend: [
        {
          data: data.categories.map((c: any) => c.name),
          textStyle: { color: '#8b949e' },
          top: 8,
          type: 'scroll',
        },
      ],
      series: [
        {
          type: 'graph',
          layout: 'force',
          roam: true,
          draggable: true,
          data: data.nodes,
          links: data.links,
          categories: data.categories,
          force: {
            repulsion: 320,
            edgeLength: 90,
            gravity: 0.08,
          },
          label: {
            show: true,
            position: 'right',
            color: '#e6edf3',
            fontSize: 12,
          },
          lineStyle: { color: 'source', curveness: 0.1, opacity: 0.5 },
          emphasis: {
            focus: 'adjacency',
            lineStyle: { width: 3 },
          },
        },
      ],
    });

    // 点击项目节点跳转
    chart.on('click', (params: any) => {
      if (params.dataType === 'node' && params.data.url) {
        window.location.href = params.data.url;
      }
    });

    // 响应式
    window.addEventListener('resize', () => chart.resize());
  }
</script>
