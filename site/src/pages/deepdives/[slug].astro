---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const deepdives = await getCollection('deepdives');
  return deepdives.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={`${d.title} · 开源宇宙`} description={d.summary}>
  <a href="/deepdives" class="text-sm text-oss-primary hover:underline">← 返回深度剖析</a>

  <header class="mt-4 mb-6">
    <div class="flex flex-wrap items-center gap-2 text-xs text-oss-muted">
      <span class="rounded bg-oss-bg px-2 py-0.5 text-oss-primary">{d.project}</span>
      <span>📅 {d.date.toLocaleDateString('zh-CN')}</span>
      {d.readingTime && <span>⏱️ {d.readingTime}</span>}
    </div>
    <h1 class="mt-3 text-3xl font-bold text-white">{d.title}</h1>
    <p class="mt-2 text-oss-muted">{d.summary}</p>
  </header>

  <article class="prose-oss">
    <Content />
  </article>
</BaseLayout>
