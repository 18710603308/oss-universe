---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { link } from '../../lib/link';

const deepdives = (await getCollection('deepdives')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="深度剖析 · 开源宇宙">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-white">🔬 深度剖析</h1>
    <p class="mt-2 text-oss-muted">
      每月 1 篇旗舰长文，深入顶级项目的架构与源码。目标 36 篇，当前 {deepdives.length} 篇。
    </p>
  </header>

  <div class="space-y-4">
    {
      deepdives.map((d) => (
        <a
          href={link(`/deepdives/${d.id}`)}
          class="group block rounded-xl border border-oss-border bg-oss-surface p-5 transition-all hover:border-oss-primary"
        >
          <div class="flex flex-wrap items-center gap-2 text-xs text-oss-muted">
            <span class="rounded bg-oss-bg px-2 py-0.5 text-oss-primary">{d.data.project}</span>
            <span>📅 {d.data.date.toLocaleDateString('zh-CN')}</span>
            {d.data.readingTime && <span>⏱️ {d.data.readingTime}</span>}
          </div>
          <h2 class="mt-2 text-lg font-bold text-white group-hover:text-oss-primary">
            {d.data.title}
          </h2>
          <p class="mt-1.5 text-sm text-oss-muted">{d.data.summary}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
