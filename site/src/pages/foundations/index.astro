---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const foundations = await getCollection('foundations');
const sorted = foundations.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="基金会 · 开源宇宙">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-white">🏛️ 开源基金会</h1>
    <p class="mt-2 text-oss-muted">
      理解开源生态的组织形态。目标覆盖 12 个主要基金会，当前 {foundations.length} 个。
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      sorted.map((f) => (
        <a
          href={`/foundations/${f.id}`}
          class="group rounded-xl border border-oss-border bg-oss-surface p-5 transition-all hover:border-oss-primary"
        >
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-white group-hover:text-oss-primary">
              {f.data.name}
            </h2>
            <span class="text-xs text-oss-muted">#{f.data.order}</span>
          </div>
          {f.data.fullName && (
            <p class="mt-1 text-sm text-oss-muted">{f.data.fullName}</p>
          )}
          <div class="mt-3 flex flex-wrap gap-2 text-xs">
            {f.data.founded && (
              <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">
                📅 {f.data.founded}
              </span>
            )}
            {f.data.projectCount && (
              <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">
                📦 {f.data.projectCount} 项目
              </span>
            )}
            {f.data.license && (
              <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">
                ⚖️ {f.data.license}
              </span>
            )}
          </div>
          <p class="mt-3 text-sm text-oss-primary">{f.data.focus}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
