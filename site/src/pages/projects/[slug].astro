---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { link } from '../../lib/link';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const depthMap = {
  seed: '🌱 了解',
  sprout: '🌿 上手',
  tree: '🌳 深研',
  peak: '🏔️ 贡献过',
};
---

<BaseLayout title={`${d.name} · 开源宇宙`} description={d.tagline}>
  <a href={link('/projects')} class="text-sm text-oss-primary hover:underline">← 返回项目库</a>

  <header class="mt-4 mb-6 rounded-xl border border-oss-border bg-oss-surface p-6">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold text-white">{d.name}</h1>
      <span class="rounded-full border border-oss-border px-3 py-1 text-sm text-oss-accent"
        >{depthMap[d.depth]}</span
      >
    </div>
    <p class="mt-2 text-oss-muted">{d.tagline}</p>

    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <span class="rounded bg-oss-bg px-2 py-1 text-oss-primary">{d.category}</span>
      {d.language && <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">💻 {d.language}</span>}
      {d.foundation && <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">🏛️ {d.foundation}</span>}
      {d.born && <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">📅 {d.born}</span>}
      {d.stars && <span class="rounded bg-oss-bg px-2 py-1 text-oss-muted">⭐ {d.stars}</span>}
    </div>

    <div class="mt-4 flex flex-wrap gap-4 text-sm">
      {d.repo && <a href={d.repo} class="text-oss-primary hover:underline" target="_blank" rel="noopener">📦 仓库</a>}
      {d.website && <a href={d.website} class="text-oss-primary hover:underline" target="_blank" rel="noopener">🔗 官网</a>}
    </div>
  </header>

  <article class="prose-oss">
    <Content />
  </article>
</BaseLayout>
