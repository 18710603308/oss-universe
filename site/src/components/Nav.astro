---
const links = [
  { href: '/', label: '仪表盘', icon: '🏠' },
  { href: '/projects', label: '项目库', icon: '🗂️' },
  { href: '/foundations', label: '基金会', icon: '🏛️' },
  { href: '/graph', label: '生态图谱', icon: '🗺️' },
  { href: '/maps', label: '专题图', icon: '📊' },
  { href: '/roadmap', label: '学习路线', icon: '🛤️' },
  { href: '/timeline', label: '编年史', icon: '📜' },
  { href: '/deepdives', label: '深度剖析', icon: '🔬' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-oss-border bg-oss-bg/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-bold text-white">
      <span class="text-xl">🌌</span>
      <span>开源宇宙</span>
    </a>
    <ul class="flex flex-wrap items-center gap-1 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-md px-3 py-1.5 transition-colors hover:bg-oss-surface',
                isActive(link.href)
                  ? 'bg-oss-surface text-oss-primary font-medium'
                  : 'text-oss-muted',
              ]}
            >
              <span class="mr-1">{link.icon}</span>
              <span class="hidden sm:inline">{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
