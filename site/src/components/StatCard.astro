---
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  icon?: string;
}
const { label, value, sub, icon } = Astro.props;
---

<div class="rounded-xl border border-oss-border bg-oss-surface p-5">
  <div class="flex items-center gap-2 text-sm text-oss-muted">
    {icon && <span>{icon}</span>}
    <span>{label}</span>
  </div>
  <div class="mt-2 text-3xl font-bold text-white">{value}</div>
  {sub && <div class="mt-1 text-xs text-oss-muted">{sub}</div>}
</div>
